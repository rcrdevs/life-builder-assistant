# Copie este arquivo para ".env" e preencha os valores.
# Nenhuma dessas variaveis eh obrigatoria para rodar o app -- sem elas, o
# Life Builder funciona 100% normalmente, so sem os "temperos" opcionais de IA.

# --- Obrigatorio em producao -------------------------------------------------
# Chave usada para assinar a sessao (cookies de login). Gere uma aleatoria com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Se nao for definida, o app usa uma chave fixa de prototipo -- OK para testar
# localmente, mas NUNCA use o valor padrao em um servidor publico.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- Opcional: painel de administracao ----------------------------------------
# E-mails (separados por virgula) que enxergam /admin -- a tela de diagnostico
# que testa ao vivo se cada integracao esta respondendo. Quem nao esta na lista
# recebe 404, entao a rota nem revela que existe. Deliberadamente fora do banco:
# nao existe tela pra promover admin, so acesso ao servidor.
ADMIN_EMAILS=

# --- Opcional: IA -------------------------------------------------------------
# Provedores de IA (quiz por tema, prova semanal e nota de estrategia).
# Sao tentados NA ORDEM abaixo -- basta um funcionar. Sem nenhum, o app roda
# normal, so com o conteudo deterministico (missoes, pontos e progressao nunca
# dependem de IA).
#
# OpenRouter (primario): uma chave da acesso a praticamente qualquer modelo, e
# ele NAO loga prompt por padrao -- importa porque o resumo enviado inclui dado
# pessoal do usuario (lesao, religiao, anotacoes livres). Sem markup na
# inferencia; a taxa e so na compra de credito.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Groq (fallback): camada gratuita de verdade e muito rapida. Serve de rede de
# seguranca se o OpenRouter falhar ou ficar sem credito.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Cota de teste gratis de IA por conta (em tokens, somando notas de estrategia
# + simulados). Ver ai_billing.py -- quando esgota, a IA para de ser chamada
# e o app mostra um link para /upgrade, mas continua funcionando normalmente.
FREE_TRIAL_AI_TOKENS=150000

# --- Opcional: YouTube Data API v3 (videos reais nas recomendacoes) ----------
# Sem a chave, a secao "Canais e videos" mostra canais curados e verificados a
# mao (link direto, mas do canal). Com a chave, o app busca o video especifico
# de cada tema, com titulo e thumbnail reais.
# Crie em https://console.cloud.google.com/ -> APIs -> "YouTube Data API v3".
# Cota: 10.000 unidades/dia e cada busca custa 100 (~100 buscas/dia no total).
# Por isso o resultado fica em cache no banco por 30 dias e a busca roda em
# background, nunca no carregamento da pagina.
YOUTUBE_API_KEY=

# --- Obrigatorio: banco de dados -----------------------------------------------
# PostgreSQL (ex: Aiven -- usamos Postgres aqui, nao MySQL, porque a conta ja
# tinha o MySQL gratis ocupado pelo KriptaHaus; a Aiven permite 1 servico
# gratis por TIPO, entao Postgres é um "slot" gratuito separado).
DB_HOST=troque-pelo-host-do-seu-postgres
DB_PORT=5432
DB_USER=troque
DB_PASSWORD=troque
DB_NAME=troque
# A Aiven (e a maioria dos provedores free tier) exige conexao criptografada.
# Deixe "1" para esses casos; troque para "0" so se estiver usando um Postgres
# local sem SSL configurado.
DB_SSL=1

# Tamanho do pool de conexoes reaproveitadas por processo (ver app.py
# get_db()). O maximo deve ficar abaixo do limite de conexoes do seu plano de
# Postgres -- free tiers costumam permitir bem menos que 100.
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Opcional: envio de e-mail (recuperacao de senha) --------------------------
# Sem essas variaveis, o fluxo de "esqueci minha senha" continua funcionando,
# so o e-mail nao sai de verdade -- o link de reset e logado no console do
# servidor, o suficiente para testar localmente. Qualquer provedor SMTP serve
# (Gmail, SendGrid, Resend, Amazon SES, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# --- Opcional: faturamento (Stripe) --------------------------------------------
# Sem STRIPE_SECRET_KEY, a tela /upgrade mostra "assinatura em breve" e nenhum
# botao de checkout aparece -- o resto do app funciona normal. Crie os Price
# IDs (assinatura mensal) no dashboard da Stripe para os planos Pro e Elite
# antes de preencher STRIPE_PRICE_PRO/STRIPE_PRICE_ELITE. STRIPE_WEBHOOK_SECRET
# vem da configuracao do endpoint de webhook (/billing/webhook) no dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Porta em que o servidor escuta dentro do container.
PORT=5000

# "1" = modo debug do Flask (recarrega automaticamente, mostra stacktrace no
# navegador). Deixe "0" em producao.
FLASK_DEBUG=0
